# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=gemma3n:e2b

# Ollama Performance Tuning
# Keep model loaded in memory indefinitely (set to "5m" to auto-unload after 5 min)
OLLAMA_KEEP_ALIVE=-1
# Max parallel inference requests (1 is optimal for low-core-count CPUs)
OLLAMA_NUM_PARALLEL=1

# Backend Configuration
DATA_PATH=./data/vector_db
API_PORT=8000
API_HOST=0.0.0.0

# Frontend Configuration (leave empty when using nginx gateway; set to backend URL for direct access)
VITE_API_BASE_URL=

# AI Personality
DEFAULT_SYSTEM_PROMPT="Copy your detailed system prompt here"

# Redis password
REDIS_PASSWORD=
ENVIRONMENT=production
